{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": "public/js",
    "rootDir": "src",
    "sourceMap": true,
    "noEmitOnError": true
  },
  "include": ["src/engine/*.ts", "src/webapp/*.ts"]
}
